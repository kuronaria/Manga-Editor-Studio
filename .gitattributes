# ===============================================================
# Line-ending normalization
# Fixes the "every file looks modified" problem on Windows:
# text files are stored as LF in the repo, converted on checkout.
# ===============================================================

# Default: auto-detect text, store as LF in the repository
* text=auto eol=lf

# Windows-only scripts MUST keep CRLF or they can misbehave
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Explicit text types (safety)
*.py    text eol=lf
*.pyi   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cfg   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.sh    text eol=lf

# ===============================================================
# Binary files - git must never touch these
# ===============================================================
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.bmp    binary
*.pt     binary
*.pth    binary
*.ckpt   binary
*.onnx   binary
*.safetensors binary
*.bin    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.zip    binary
*.gz     binary
*.7z     binary
*.pdf    binary
